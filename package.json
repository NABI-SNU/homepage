{
  "name": "homepage",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "prebuild": "pnpm generate:importmap",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "predev": "rm -rf .next/cache && pnpm generate:importmap",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "predev:turbopack": "rm -rf .next/cache && pnpm generate:importmap",
    "dev:turbopack": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "db:check:activity-indexes": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/check-activity-indexes.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:repair": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/repair-migration-state.ts",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "prepare": "husky",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "seed:test-accounts": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/seed-test-accounts.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "format:check": "cross-env NODE_OPTIONS=--no-deprecation prettier --check .",
    "seed:program-2026": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/seed-2026-program.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@delmaredigital/payload-better-auth": "^0.6.1",
    "@neondatabase/serverless": "^1.1.0",
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/email-nodemailer": "3.92.0",
    "@payloadcms/live-preview-react": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/plugin-form-builder": "3.92.0",
    "@payloadcms/plugin-nested-docs": "3.92.0",
    "@payloadcms/plugin-redirects": "3.92.0",
    "@payloadcms/plugin-search": "3.92.0",
    "@payloadcms/plugin-seo": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-s3": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@tweenjs/tween.js": "^25.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "d3": "^7.9.0",
    "dotenv": "17.3.1",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "0.577.0",
    "myst-parser": "^1.7.0",
    "myst-to-html": "^1.7.0",
    "next": "16.4.3",
    "next-sitemap": "^4.2.3",
    "nodemailer": "^10.3.1",
    "payload": "3.92.0",
    "pg": "^8.20.0",
    "pixi.js": "^8.16.0",
    "plotly.js-dist-min": "^3.4.0",
    "plugin-redirects@3.79.1": "link:payloadcms/plugin-redirects@3.79.1",
    "plugin-search@3.79.1": "link:payloadcms/plugin-search@3.79.1",
    "plugin-seo@3.79.1": "link:payloadcms/plugin-seo@3.79.1",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.2",
    "richtext-lexical@3.79.1": "link:payloadcms/richtext-lexical@3.79.1",
    "sharp": "0.35.5",
    "styled-components": "6.4.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "16.3.2",
    "@types/d3": "^7.4.3",
    "@types/escape-html": "^1.0.2",
    "@types/node": "25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.32",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "^7.29.7",
      "@csstools/css-parser-algorithms@<4.0.2": "^4.0.2",
      "@csstools/css-tokenizer@<4.0.2": "^4.0.2",
      "@hono/node-server": "^2.1.5",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "@xmldom/xmldom@<0.8.15": "^0.8.15",
      "baseline-browser-mapping@<2.11.0": "^2.11.34",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.29.5",
      "csv-parse@<7.0.2": "^7.0.3",
      "deepmerge-ts@<8.0.0": "^8.0.2",
      "dompurify": "^3.4.17",
      "effect@<3.20.0": "^3.22.4",
      "esbuild": "^0.25.0",
      "fast-copy@<3.1.0": "^3.1.0",
      "fast-uri@<3.1.9": "^3.1.9",
      "fast-xml-builder@<1.1.7": "^1.3.1",
      "fast-xml-parser": "^5.11.2",
      "flatted@<3.4.2": "^3.4.4",
      "happy-dom@<21.0.4": "^21.0.4",
      "hono": "^4.12.4",
      "immutable": "^4.3.9",
      "js-yaml@<3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "linkify-it@<5.0.2": "^5.0.2",
      "lodash": "^4.17.23",
      "markdown-it": "^14.3.3",
      "minimatch@>=10.0.0 <11.0.0": "^11.0.3",
      "mysql2@<3.23.1": "^3.24.6",
      "nanoid@<3.3.18": "^3.3.18",
      "nanoid@>=4.0.0 <5.1.16": "^5.1.16",
      "payload>ajv": "^8.18.0",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "valibot@<1.4.2": "^1.5.0",
      "vite@>=7.0.0 <7.3.7": "^7.3.7",
      "ws@>=8.0.0 <8.21.0": "^8.22.1",
      "zod@>=4.0.0 <4.6.6": "^4.6.7"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@prisma/engines",
      "prisma"
    ],
    "patchedDependencies": {
      "markdown-it-dollarmath@0.5.0": "patches/markdown-it-dollarmath@0.5.0.patch",
      "myst-to-html@1.7.0": "patches/myst-to-html@1.7.0.patch"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "pnpm exec eslint --max-warnings=0 --no-warn-ignored --fix",
      "pnpm exec prettier --write"
    ],
    "*.{json,md,css,scss,yml,yaml}": [
      "pnpm exec prettier --write"
    ]
  }
}
